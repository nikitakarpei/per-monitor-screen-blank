{
    "workspaces": {
        ".": {
            "entry": [
                "types/shell-ambient.d.ts",
                "types/prefs-ambient.d.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/application": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/core": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/host-gnome-prefs": {
            "entry": [
                "src/prefs.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/host-gnome-shell": {
            "entry": [
                "src/extension.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/infrastructure-gnome": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        }
    },
    "ignoreDependencies": [
        "^gi$",
        "^resource$",
        "^ts-api-utils$",
        "^esbuild$",
        "^semver$",
        "^@girs/gnome-shell$",
        "^@girs/gtk-4\\.0$",
        "^@girs/adw-1$",
        "^@girs/gdk-4\\.0$",
        "^@girs/glib-2\\.0$",
        "^@girs/gobject-2\\.0$",
        "^@girs/gio-2\\.0$",
        "^@girs/gmodule-2\\.0$",
        "^@girs/pango-1\\.0$",
        "^@girs/pangocairo-1\\.0$",
        "^@girs/gjs$"
    ]
}
