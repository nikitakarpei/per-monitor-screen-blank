{
    "workspaces": {
        ".": {
            "entry": [
                "platforms/gnome/packages/host-gnome-shell/src/shell-ambient.d.ts",
                "platforms/gnome/packages/host-gnome-prefs/src/prefs-ambient.d.ts"
            ],
            "project": [
                "core/packages/*/src/**/*.ts",
                "platforms/*/packages/*/src/**/*.ts"
            ]
        },
        "core/packages/application": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "core/packages/domain": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "platforms/gnome/packages/host-gnome-prefs": {
            "entry": [
                "src/prefs.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "platforms/gnome/packages/host-gnome-shell": {
            "entry": [
                "src/extension.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "platforms/gnome/packages/infrastructure-gnome": {
            "entry": [
                "src/index.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        }
    },
    "ignoreDependencies": [
        "^gi$",
        "^resource$",
        "^ts-api-utils$",
        "^esbuild$",
        "^semver$",
        "^@girs/gnome-shell$",
        "^@girs/gtk-4\\.0$",
        "^@girs/adw-1$",
        "^@girs/gdk-4\\.0$",
        "^@girs/glib-2\\.0$",
        "^@girs/gobject-2\\.0$",
        "^@girs/gio-2\\.0$",
        "^@girs/gmodule-2\\.0$",
        "^@girs/pango-1\\.0$",
        "^@girs/pangocairo-1\\.0$",
        "^@girs/gjs$"
    ]
}
