{
    "extends": "../../../tsconfig.build.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@pmsb/domain": ["../domain/src/index.ts"],
            "@pmsb/lifecycle": ["../lifecycle/src/index.ts"]
