{
    "extends": "../../tsconfig.build.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@pmsb/core": ["../core/dist/index.d.ts"],
            "@pmsb/application": ["../application/dist/index.d.ts"],
            "@pmsb/infrastructure-gnome": [
                "../infrastructure-gnome/dist/index.d.ts"
            ]
        }
    },
    "include": ["src/**/*.ts", "src/shell-ambient.d.ts"],
    "references": [
        { "path": "../core/tsconfig.json" },
        { "path": "../application/tsconfig.json" },
        { "path": "../infrastructure-gnome/tsconfig.json" }
    ]
}
