{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "@pmsb/domain": ["./core/packages/domain/src/index.ts"],
            "@pmsb/application": ["./core/packages/application/src/index.ts"],
            "@pmsb/lifecycle": ["./core/packages/lifecycle/src/index.ts"],
            "@pmsb/infrastructure-gnome": ["./platforms/gnome/packages/infrastructure-gnome/src/index.ts"],
            "@pmsb/gnome-shell": ["./platforms/gnome/packages/gnome-shell/src/index.ts"],
            "@pmsb/gnome-prefs": ["./platforms/gnome/packages/gnome-prefs/src/index.ts"],
            "@pmsb/gnome-composition": ["./platforms/gnome/packages/gnome-composition/src/index.ts"]
        }
    },
    "include": [
        "core/packages/*/src/**/*.ts",
        "core/packages/*/src/**/*.d.ts",
        "platforms/*/packages/*/src/**/*.ts",
        "platforms/*/packages/*/src/**/*.d.ts"
    ]
}
