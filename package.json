    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^16.4.0",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "ts-api-utils": "^2.5.0",
    "typescript": "^6.0.2"
  }
}
