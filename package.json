{
  "name": "per-monitor-screen-blank",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "lint:js": "eslint src",
    "lint:dead-code": "knip --reporter compact",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc"
