{
    "name": "per-monitor-screen-blank",
    "private": true,
    "type": "module",
    "workspaces": [
        "local-plugins/*"
    ],
    "scripts": {
        "lint": "eslint src",
        "lint:js": "eslint src",
        "lint:dead-code": "knip --reporter compact",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "typecheck": "tsc",
        "test": "vitest",
        "prepare": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "pre-push": "npm run lint:dead-code && npm run typecheck"
    },
    "lint-staged": {
        "src/**/*.{js,ts}": [
            "prettier --write",
            "eslint"
        ]
    },
    "overrides": {
        "@girs/mtk-17": "17.0.0-4.0.0-rc.3",
        "@girs/atk-1.0": "2.60.0-4.0.0-rc.4",
        "@girs/cairo-1.0": "1.0.0-4.0.0-rc.4",
        "@girs/freetype2-2.0": "2.0.0-4.0.0-rc.4",
        "@girs/gdk-4.0": "4.0.0-4.0.0-rc.4",
        "@girs/gdkpixbuf-2.0": "2.0.0-4.0.0-rc.4",
        "@girs/gio-2.0": "2.88.0-4.0.0-rc.4",
        "@girs/gjs": "4.0.0-rc.4",
        "@girs/glib-2.0": "2.88.0-4.0.0-rc.4",
        "@girs/gmodule-2.0": "2.0.0-4.0.0-rc.4",
        "@girs/gobject-2.0": "2.88.0-4.0.0-rc.4",
        "@girs/graphene-1.0": "1.0.0-4.0.0-rc.4",
        "@girs/gsk-4.0": "4.0.0-4.0.0-rc.4",
        "@girs/gtk-4.0": "4.23.0-4.0.0-rc.4",
        "@girs/harfbuzz-0.0": "13.2.1-4.0.0-rc.4",
        "@girs/pango-1.0": "1.57.1-4.0.0-rc.4",
        "@girs/pangocairo-1.0": "1.0.0-4.0.0-rc.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@girs/gnome-shell": "49.1.0",
        "esbuild": "^0.28.0",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.0.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.5.0",
        "knip": "^6.4.1",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "semver": "^7.7.4",
        "simple-git-hooks": "^2.13.1",
        "ts-api-utils": "^2.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.4"
    }
}
